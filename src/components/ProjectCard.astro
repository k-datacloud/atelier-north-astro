---
interface Props {
  number: string;
  title: string;
  location: string;
  image: ImageMetadata;
}

const { number, title, location, image } = Astro.props;
---

<article class="p-top-projects__card">
  <p class="text-sm">({number})</p>
  <div class="p-top-projects__card-img js-pixel">
    <canvas class="js-pixel-canvas"></canvas>
    <img src={image.src} alt="" class="js-source-image" />
  </div>
  <div class="p-top-projects__card-info">
    <p class="text-sm">{title}</p>
    <p class="text-sm">{location}</p>
  </div>
</article>
