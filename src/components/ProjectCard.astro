---
interface Props {
  number: string;
  title: string;
  location: string;
  image: ImageMetadata;
}

const { number, title, location, image } = Astro.props;
---

<article class="p-top-projects__card">
  <p class="text-base">({number})</p>
  <div class="p-top-projects__card-img">
    <img src={image.src} alt="" />
  </div>
  <div class="p-top-projects__card-info">
    <p class="text-base">{title}</p>
    <p class="text-base">{location}</p>
  </div>
</article>
