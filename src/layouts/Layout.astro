---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.scss";
---

<!doctype html>
<html lang="en">
  <head>
    <Head />
  </head>
  <body>
    <div class="menu-button js-menu-button">
      <button class="menu-button__button" type="button">
        <span class="text-wrapper">
          <span class="menu-button__label text-base">
            <span>MENU</span>
            <span>[+]</span>
          </span>
          <span class="menu-button__label menu-button__label--clone text-base">
            <span>MENU</span>
            <span>[+]</span>
          </span>
        </span>
      </button>
    </div>
    <div class="menu js-menu">
      <ul class="menu__list">
        <p class="text-base">[INDEX]</p>
        <li class="menu__list-item">
          <a class="menu__list-item-link text-base" href="/about">ABOUT</a>
        </li>
        <li class="menu__list-item">
          <a class="menu__list-item-link text-base" href="/projects">PROJECTS</a
          >
        </li>
        <li class="menu__list-item">
          <a class="menu__list-item-link text-base" href="/members">MEMBERS</a>
        </li>
        <li class="menu__list-item">
          <a class="menu__list-item-link text-base" href="/contact">CONTACT</a>
        </li>
      </ul>
      <div class="divider"></div>
      <div class="menu__contact">
        <p class="text-base">[EMAIL]</p>
        <a class="text-base" href="">info@ateliernorth.com</a>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <Footer />
  </body><script type="module">
    import "../scripts/global.js";
  </script>
</html>
