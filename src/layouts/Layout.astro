---
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.scss";
---

<!doctype html>
<html lang="en">
  <head>
    <Head />
  </head>
  <body>
    <div class="menu js-menu">
      <div class="menu__wrapper">
        <ul class="menu__list">
          <p class="anton">
            <span class="text-wrapper">
              <span>[INDEX]</span>
            </span>
          </p>
          <li class="menu__list-item">
            <a
              class="menu__list-item-link anton js-smooth-scroll"
              href="#about"
            >
              <span class="text-wrapper">
                <span>ABOUT</span>
              </span>
            </a>
          </li>
          <li class="menu__list-item">
            <a
              class="menu__list-item-link anton js-smooth-scroll"
              href="#projects"
            >
              <span class="text-wrapper">
                <span>PROJECTS</span>
              </span>
            </a>
          </li>
          <li class="menu__list-item">
            <a
              class="menu__list-item-link anton js-smooth-scroll"
              href="#members"
            >
              <span class="text-wrapper">
                <span>MEMBERS</span>
              </span>
            </a>
          </li>
        </ul>
        <div class="divider"></div>
        <div class="menu__contact">
          <p class="anton">
            <span class="text-wrapper">
              <span>[EMAIL]</span>
            </span>
          </p>
          <a class="anton" href="">
            <span class="text-wrapper">
              <span>info@ateliernorth.com</span>
            </span>
          </a>
        </div>
      </div>
    </div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body><script type="module">
    import "../scripts/global.js";
  </script>
</html>
